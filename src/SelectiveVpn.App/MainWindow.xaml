<Window x:Class="SelectiveVpn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectiveVpn" Width="1080" Height="760" MinWidth="850" MinHeight="620"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Border Background="{StaticResource CanvasBrush}">
    <Grid Margin="24,18,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Text="SelectiveVpn" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14"/>

      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ConnectionDot" Fill="{StaticResource MutedBrush}" Width="8" Height="8" Margin="0,0,8,0"/>
              <TextBlock x:Name="ConnectionStateText" Text="Проверка службы" FontSize="17" FontWeight="SemiBold"
                         AutomationProperties.LiveSetting="Polite"/>
              <TextBlock x:Name="SessionText" Style="{StaticResource Hint}" Margin="12,2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Получаем состояние VPN…" Style="{StaticResource Hint}" Margin="16,4,0,0"
                       MaxHeight="38" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ConnectButton" Content="Подключить" Click="Connect_Click" IsEnabled="False" MinWidth="113"
                    Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="DisconnectButton" Content="Отключить" Click="Disconnect_Click" IsEnabled="False" MinWidth="100"
                    Style="{StaticResource CommandButton}"/>
          </StackPanel>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <Label Content="Сервер" Target="{Binding ElementName=ServersBox}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,4"/>
              <ComboBox x:Name="ServersBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="Server_Changed"
                        IsEnabled="False" Style="{StaticResource Field}" ToolTip="Выбор сохраняется сразу. При подключённом VPN сервер переключается."/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <Label Content="Протокол" Target="{Binding ElementName=ProtocolBox}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,4"/>
              <ComboBox x:Name="ProtocolBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Protocol_Changed"
                        IsEnabled="False" Style="{StaticResource Field}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <TabControl x:Name="Pages" Grid.Row="2" Style="{StaticResource GraphiteTabs}">
        <TabItem Header="Маршрутизация">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,9">
              <TextBlock x:Name="ProtectionText" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <TextBlock Text="Правила трафика" Style="{StaticResource SectionTitle}"/>
            </DockPanel>
            <Grid x:Name="RuleEditor" IsEnabled="False" Grid.Row="1" Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="122"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="KindBox" AutomationProperties.Name="Тип правила" DisplayMemberPath="Label" SelectedValuePath="Value"
                        Style="{StaticResource Field}" Margin="0,0,8,0"/>
              <Grid Grid.Column="1" Margin="0,0,8,0">
                <TextBox x:Name="ValueBox" AutomationProperties.Name="Домен, IP или путь приложения"
                         ToolTip="example.com, 203.0.113.0/24 или путь к приложению" MinHeight="34"
                         Padding="9,3" VerticalContentAlignment="Center" Foreground="{StaticResource InkBrush}"
                         Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DividerBrush}"/>
                <TextBlock Text="Домен, IP или путь" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=ValueBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Button Grid.Column="2" Content="Файл .exe…" Click="Browse_Click" Style="{StaticResource CommandButton}" Margin="0,0,8,0"/>
              <ComboBox x:Name="TargetBox" Grid.Column="3" AutomationProperties.Name="Маршрут правила" DisplayMemberPath="Label"
                        SelectedValuePath="Value" Style="{StaticResource Field}" Margin="0,0,8,0"/>
              <Button Grid.Column="4" Content="Добавить" Click="Add_Click" Style="{StaticResource CommandButton}"/>
            </Grid>
            <Grid Grid.Row="2">
              <DataGrid x:Name="RulesGrid" AutomationProperties.Name="Правила трафика" AutoGenerateColumns="False" CanUserAddRows="False"
                        CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" IsReadOnly="True"
                        SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled"
                        HorizontalGridLinesBrush="{StaticResource DividerBrush}" RowHeight="39" Background="{StaticResource InsetBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" ColumnHeaderStyle="{StaticResource RulesHeader}"
                        RowStyle="{StaticResource RulesRow}" CellStyle="{StaticResource RulesCell}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Тип" Binding="{Binding KindLabel}" Width="166" ElementStyle="{StaticResource RuleValue}"/>
                  <DataGridTextColumn Header="Приложение, домен или IP" Binding="{Binding Rule.Value}" Width="*" MinWidth="182" ElementStyle="{StaticResource RuleValue}"/>
                  <DataGridTextColumn Header="Маршрут" Binding="{Binding TargetLabel}" Width="116"/>
                  <DataGridTextColumn Header="Состояние" Binding="{Binding EnabledLabel}" Width="105"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Выбери тип, введи адрес или путь и нажми «Добавить»." TextAlignment="Center"
                         IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,32,24,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=RulesGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <Grid x:Name="RuleActions" IsEnabled="False" Grid.Row="3" Margin="0,9,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <WrapPanel>
                <Button Content="Удалить" Click="Remove_Click" Style="{StaticResource SelectedRuleButton}" Margin="0,0,6,0"/>
                <Button Content="Вкл. / выкл." Click="Toggle_Click" Style="{StaticResource SelectedRuleButton}" Margin="0,0,6,0"/>
                <Button Content="Выше" Click="Up_Click" Style="{StaticResource SelectedRuleButton}" Margin="0,0,6,0"/>
                <Button Content="Ниже" Click="Down_Click" Style="{StaticResource SelectedRuleButton}"/>
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Label Content="Остальной трафик" Target="{Binding ElementName=DefaultBox}" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Padding="0,0,8,0"/>
                <ComboBox x:Name="DefaultBox" Width="124" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectionChanged="Changed" Style="{StaticResource Field}"/>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Настройки">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,16,16,4">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="DomainSettings" IsEnabled="False" Margin="0,0,20,0">
                  <TextBlock Text="Защита при отключении" Style="{StaticResource SectionTitle}"/>
                  <CheckBox x:Name="BlockDomainsBox" Margin="0,8,0,4" Checked="Changed" Unchecked="Changed">
                    <TextBlock Text="Блокировать VPN-домены без подключения" TextWrapping="Wrap"/>
                  </CheckBox>
                  <TextBlock Text="Фильтрует распознанные домены, пока работают служба и сетевой фильтр. Приложения с правилом «Через VPN» блокируются средствами Windows." Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="Запуск Windows" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                  <StackPanel x:Name="StartupSettings" IsEnabled="False">
                    <CheckBox x:Name="AutoConnectBox" Content="Подключать VPN при запуске службы" Checked="Changed" Unchecked="Changed" Margin="0,0,0,6"
                              ToolTip="Работает при запуске службы, в том числе при загрузке Windows до входа пользователя."/>
                    <CheckBox x:Name="LogonBox" Content="Подключать VPN при входе в Windows" Checked="Changed" Unchecked="Changed" Margin="0,0,0,6"/>
                  </StackPanel>
                  <CheckBox x:Name="InterfaceStartupBox" Content="При входе открывать интерфейс в трее"
                            Checked="InterfaceStartup_Changed" Unchecked="InterfaceStartup_Changed"
                            ToolTip="Только для текущего пользователя. Настройка сохраняется сразу."/>
                </StackPanel>
              </Grid>
              <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,9"/>

              <TextBlock Text="Серверы и служба" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Content="Обновить каталог" Click="RefreshServers_Click" Style="{StaticResource CommandButton}" Margin="0,0,8,8"/>
                <Button Content="Импорт серверов" Click="Import_Click" Style="{StaticResource CommandButton}" Margin="0,0,8,8"/>
                <Button x:Name="StartServiceButton" Content="Запустить службу" Click="StartService_Click" Style="{StaticResource CommandButton}" Margin="0,0,8,8"/>
                <Button x:Name="StopServiceButton" Content="Остановить службу" Click="StopService_Click" Style="{StaticResource CommandButton}" Margin="0,0,0,8"/>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Диагностика">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Открыть файл журнала" Click="OpenLog_Click" Style="{StaticResource CommandButton}" Margin="12,0,0,0"/>
              <TextBlock Text="События службы" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
              <TextBlock x:Name="ConnectionStatsText" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
              <CheckBox x:Name="DiagnosticsBox" IsEnabled="False" Content="Подробный журнал маршрутизации" Checked="Changed" Unchecked="Changed"/>
            </StackPanel>
            <TextBox x:Name="EventsBox" Grid.Row="2" AutomationProperties.Name="События службы" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="12"
                     TextWrapping="Wrap" Padding="10" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DividerBrush}"/>
          </Grid>
        </TabItem>
      </TabControl>

      <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}" Margin="0,12,0,0" Padding="0,11,0,0">
        <DockPanel>
          <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Сохранить изменения" Click="Save_Click" MinWidth="168"
                  IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
          <TextBlock x:Name="DraftText" Text="Загрузка настроек…" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"
                     AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
