<Window x:Class="SelectiveVpn.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectiveVpn — маршрутизация приложений" Width="1120" Height="800" MinWidth="900" MinHeight="650" Background="#F5F7FA" FontFamily="Segoe UI" FontSize="14">
  <Grid x:Name="ControlRoot" Margin="24" Background="#F5F7FA">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <StackPanel><TextBlock Text="SelectiveVpn" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Прямое подключение и VPN — по вашим правилам" Foreground="#526074"/></StackPanel>
      <TextBlock x:Name="ProtectionText" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
    </DockPanel>
    <Border Grid.Row="1" Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,16">
      <StackPanel>
        <WrapPanel Margin="0,0,0,12">
          <Button x:Name="StartServiceButton" Content="Запустить службу" Click="StartService_Click"/>
          <Button x:Name="StopServiceButton" Content="Остановить службу" Click="StopService_Click"/>
          <Button Content="Обновить серверы" Click="RefreshServers_Click"/>
          <Button Content="Открыть журнал" Click="OpenLog_Click"/>
        </WrapPanel>
        <CheckBox x:Name="InterfaceStartupBox" Content="Запускать интерфейс при входе в Windows сразу в трей" Checked="InterfaceStartup_Changed" Unchecked="InterfaceStartup_Changed" ToolTip="Для текущего пользователя. Сохраняется сразу; не включает VPN автоматически." Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText" Text="Подключение к службе…" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="ConnectionStatsText" TextWrapping="Wrap" Foreground="#526074" Margin="0,0,0,8"/>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
            <Button Content="Подключить" Click="Connect_Click"/><Button Content="Отключить" Click="Disconnect_Click"/><Button Content="Импорт серверов" Click="Import_Click"/>
          </StackPanel>
          <ComboBox x:Name="ServersBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="Server_Changed" ToolTip="Выбор сохраняется автоматически. При подключённом VPN сервер переключается сразу."/>
        </DockPanel>
        <TextBlock Text="Выбранный сервер сохраняется автоматически" Foreground="#526074" FontSize="12" Margin="0,8,0,0"/>
        <DockPanel Margin="0,10,0,0"><TextBlock Text="Протокол: " VerticalAlignment="Center"/><ComboBox x:Name="ProtocolBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Protocol_Changed"/></DockPanel>
      </StackPanel>
    </Border>
    <StackPanel x:Name="RuleEditor" Grid.Row="2" Margin="0,0,0,12">
      <DockPanel Margin="0,0,0,12">
        <TextBlock Text="Правила маршрутизации" FontWeight="SemiBold" FontSize="19"/>
        <CheckBox x:Name="AutoConnectBox" Content="При запуске службы (включая загрузку Windows)" HorizontalAlignment="Right" Checked="Changed" Unchecked="Changed"/>
      </DockPanel>
      <WrapPanel Margin="0,0,0,8"><CheckBox x:Name="LogonBox" Content="Подключаться при входе в Windows" Checked="Changed" Unchecked="Changed" Margin="0,0,20,0"/><CheckBox x:Name="DiagnosticsBox" Content="Подробный журнал маршрутизации" Checked="Changed" Unchecked="Changed" Margin="0,0,20,0"/><CheckBox x:Name="BlockDomainsBox" Content="Блокировать VPN-домены без подключения" Checked="Changed" Unchecked="Changed" ToolTip="Фильтрует распознанные домены, пока служба и сетевой фильтр работают."/></WrapPanel>
      <TextBlock Text="Приложения «Через VPN» блокируются без VPN. Приоритет: приложения → домены → IP. Внутри группы действует первое совпадение." TextWrapping="Wrap" Foreground="#526074" Margin="0,0,0,12"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="KindBox" SelectedIndex="0" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,0,8,0"/>
        <TextBox x:Name="ValueBox" Grid.Column="1" ToolTip="example.com, 203.0.113.0/24 или полный путь к .exe" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Content=".exe…" Click="Browse_Click"/>
        <ComboBox x:Name="TargetBox" Grid.Column="3" SelectedIndex="0" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,0,8,0"/>
        <Button Grid.Column="4" Content="Добавить" Click="Add_Click" Margin="0"/>
      </Grid>
    </StackPanel>
    <DataGrid x:Name="RulesGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" Background="White">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Тип" Binding="{Binding KindLabel}" Width="150"/>
        <DataGridTextColumn Header="Приложение / домен / адрес" Binding="{Binding Rule.Value}" Width="*" MinWidth="360"/>
        <DataGridTextColumn Header="Маршрут" Binding="{Binding TargetLabel}" Width="140"/>
        <DataGridCheckBoxColumn Header="Включено" Binding="{Binding Rule.Enabled}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid x:Name="RuleActions" Grid.Row="4" Margin="0,12,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button Content="Удалить" Click="Remove_Click"/><Button Content="Вкл / выкл" Click="Toggle_Click"/><Button Content="↑" Click="Up_Click"/><Button Content="↓" Click="Down_Click"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,16,0"><TextBlock Text="Остальной трафик: " VerticalAlignment="Center"/><ComboBox x:Name="DefaultBox" Width="130" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Changed"/></StackPanel>
      <Button x:Name="SaveButton" Grid.Column="2" Content="Сохранить правила" Click="Save_Click" Margin="0"/>
    </Grid>
    <TextBox x:Name="EventsBox" Grid.Row="5" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Background="#EAF0F6" BorderThickness="0"/>
  </Grid>
</Window>
